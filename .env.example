# ============================================================
# AI Software Engineer Agent — environment variable template
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ----------------------------------------------------------
# Meta Model API (primary LLM provider)
# Get your key at: https://dev.meta.ai/
# ----------------------------------------------------------
META_API_KEY=your_meta_api_key_here

# Model to use by default (optional — defaults to muse-spark-1.3)
# Verified identifiers (2026-10-26): muse-wonder-1.0, muse-spark-1.3,
#   muse-spark-1.3-contributor, muse-spark-1.2, muse-spark-1.1
META_DEFAULT_MODEL=muse-spark-1.3

# ----------------------------------------------------------
# Budget controls
# ----------------------------------------------------------

# Hard spend cap per session in USD. Agent aborts when reached.
PROVIDER_BUDGET_USD=5.00

# Set to true to allow fallback to a secondary provider when
# Meta API is unavailable. Requires FALLBACK_BUDGET_USD > 0.
FALLBACK_PROVIDER_ENABLED=false
FALLBACK_BUDGET_USD=0.00

# ----------------------------------------------------------
# GitHub
# ----------------------------------------------------------
# Personal access token with repo:read scope for the target repositories.
# Do not give write scope unless the agent needs to open PRs.
GITHUB_TOKEN=your_github_token_here

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ----------------------------------------------------------
# Cache
# ----------------------------------------------------------
# TTL for analysis result cache entries in seconds (default 24 h)
CACHE_MAX_AGE_SECONDS=86400
